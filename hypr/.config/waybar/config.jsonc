{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,
    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["network", "cpu", "custom/gpu", "memory", "wireplumber", "tray", "clock"],
    "custom/launcher": {
        "format": "",
        "tooltip-format": "Applications · Super+R",
        "on-click": "rofi -show drun -theme ~/.config/hypr/rofi.rasi"
    },
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}",
        "sort-by-number": true,
        "on-click": "activate",
        "disable-scroll": true
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 16,
        "separate-outputs": true,
        "icon": false
    },
    "clock": {
        "format": "{:%a %d %b · %H:%M}",
        "format-alt": "{:%Y-%m-%d · %H:%M:%S}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": { "format": "CPU {usage}%", "interval": 3 },
    "custom/gpu": {
        "exec": "python3 ~/.config/waybar/scripts/gpu.py",
        "return-type": "json",
        "interval": 3,
        "format": "{}"
    },
    "memory": {
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "interval": 5
    },
    "network": {
        "format-wifi": "WiFi ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-ethernet": "ETH ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "format-disconnected": "NET off",
        "tooltip-format": "{ifname} · {ipaddr}\nDownload: {bandwidthDownBytes}\nUpload: {bandwidthUpBytes}",
        "interval": 1
    },
    "wireplumber": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{node_name}"
    },
    "tray": { "icon-size": 16, "spacing": 10 }
}
